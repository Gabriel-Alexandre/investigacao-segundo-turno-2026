; Jeanine Áñez: {{cite web|url=https://www.atb.com.bo/pol%C3%ADtica/jeanine-%C3%A1%C3%B1ez-confirma-candidatura-presidencial-para-las-elecciones-generales|title=Jeanine Áñez confirma candidatura presidencial para las elecciones generales|date=24 January 2020|access-date=24 January 2020|website=ATBDigital|language=es-ES|archive-date=22 October 2020|archive-url=https://web.archive.org/web/20201022105839/https://www.atb.com.bo/pol%C3%ADtica/jeanine-%C3%A1%C3%B1ez-confirma-candidatura-presidencial-para-las-elecciones-generales|url-status=dead}}
; Chi Hyung Chung: {{cite web|url=https://correodelsur.com/politica/20191126_chi-hyung-chung-confirma-que-sera-candidato-en-las-nuevas-elecciones.html|title=Chi Hyung Chung confirma que será candidato en las nuevas elecciones|access-date=23 December 2019|website=Correo del Sur|language=es-ES}}
; Jorge "Tuto" Quiroga: {{cite web|url=https://fmbolivia.com.bo/mnr-rompe-acuerdo-con-fernando-camacho-y-decide-apoyar-a-jorge-tuto-quiroga/|title=MNR rompe acuerdo con Fernando Camacho y decide apoyar a Jorge "Tuto" Quiroga|date=22 January 2020|access-date=22 January 2020|website=fmbolivia.com|language=es-ES|archive-date=1 March 2020|archive-url=https://web.archive.org/web/20200301210043/https://fmbolivia.com.bo/mnr-rompe-acuerdo-con-fernando-camacho-y-decide-apoyar-a-jorge-tuto-quiroga/|url-status=dead}}
; Jallalla Bolivia: {{cite web|url=https://www.noticiasfides.com/nacional/politica/jallalla-bolivia-presenta-a-una-mujer-de-pollera-como-candidata-a-la-vicepresidencia--403345|title=Jallalla Bolivia presenta a una mujer aymara como candidata a la vicepresidencia|date=23 January 2020|access-date=23 January 2020|website=noticiasfides.com|language=es-ES}}
; Doria Medina: {{cite web|url=https://www.paginasiete.bo/nacional/2020/1/31/doria-medina-sera-el-acompanante-de-anez-en-la-carrera-electoral-245214.html|title=Doria Medina será el acompañante de Añez en la carrera electoral|date=31 January 2020|access-date=31 January 2020|website=paginasiete.bo|language=es-ES|archive-date=22 October 2020|archive-url=https://web.archive.org/web/20201022112148/https://www.paginasiete.bo/nacional/2020/1/31/doria-medina-sera-el-acompanante-de-anez-en-la-carrera-electoral-245214.html|url-status=dead}}
